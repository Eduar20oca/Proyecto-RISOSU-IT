@model ML.ProductoSucursal


<h2>GetAll</h2>
<h3>Producto</h3>

@using (Html.BeginForm("GetAll", "ProductoSucursal", FormMethod.Post))
{
    <div class="container">
        <div class="row">
            <label>Selecciona una Sucursal para consultar los productos</label>
            <div class="col-4">
                @Html.DropDownListFor(Model => Model.Sucursal.IdSucursal, new SelectList(Model.Sucursal.Sucursales, "IdSucursal", "Nombre"), "Selecciona una Sucursal", new { @class = "form-control", id = "DDL" })
            </div>
            <div class="col-4">
                <button class="btn btn-success">Buscar</button>
            </div>
        </div>
    </div>
}



<div class="container">
    <hr />
    <h2>Productos que pertenecen a la Sucursal</h2>
    <div class="row">
        <div class="table-responsive">
            <table class="table col-12">
                <thead class="text-center">
                    <tr>
                        <th>Editar</th>
                        <th>Imagen</th>
                        <th>Producto</th>
                        <th>Sucursal</th>
                        <th>Stock</th>
                        <th>Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                        @foreach (ML.ProductoSucursal item in Model.ProductosSucursales ?? new List<object>())
                        {
                           <tr class="text-center">
                            <td><button class="btn btn-warning btn-editar" id="btnEdt">Editar</button></td>
                            <td><img src="data:image/jpeg;base64,@item.Producto.Base64" style= "width:100px"></td>
                            <td>@item.Producto.Nombre</td>
                            <td>@item.Sucursal.Nombre</td>
                            <td><input id="@item.IdProductoSucursal" class="form-control stock-input" style="width:200px" disabled type="int" min="0" value="@item.Stock" /></td>
                            <td> <a href="#" class="btn btn-primary" onclick="GuardarStock(@item.IdProductoSucursal, '@item.Producto.Nombre')">Guardar</a>
                            <button class="btn btn-danger"> <i class="bi bi-trash"></i>  </button></td>
                          </tr>
                        }
                </tbody>
            </table>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

    let filaActiva = null;

    $(document).on("click", ".btn-editar", function () {
        let fila = $(this).closest("tr");  
        let input = fila.find(".stock-input");
        let boton = $(this);

        
        if (filaActiva && filaActiva[0] !== fila[0]) {
            resetFila(filaActiva);
        }

        // Toggle Editar / Cancelar
        if (input.prop("disabled")) {
            input.prop("disabled", false);
            boton.removeClass("btn-warning").addClass("btn-secondary").text("Cancelar");
            filaActiva = fila;
        } else {
            resetFila(fila);
            filaActiva = null;
        }
    });

    function resetFila(fila) {
        fila.find(".stock-input").prop("disabled", true);
        fila.find(".btn-editar").removeClass("btn-secondary").addClass("btn-warning").text("Editar");
    }


    function GuardarStock(id, Nombre) {
        var stock = $("#" + id).val();

        $.ajax({
            url: '@Url.Action("UpdateStock" , "ProductoSucursal")',
            type: 'POST',
            data: {IdProductoSucursal: id, Stock: stock, Nombre: Nombre }, 
            success: alert("Stock Actualizado")            
        });
    }


</script>